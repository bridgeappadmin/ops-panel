{
  "name": "ops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "playwright test --project=unit",
    "test:mocked": "playwright test --project=mocked",
    "stack:up": "docker compose -f e2e/stack/docker-compose.yml up -d --wait",
    "stack:down": "docker compose -f e2e/stack/docker-compose.yml down"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "typescript-eslint": "8.71.2"
  }
}
